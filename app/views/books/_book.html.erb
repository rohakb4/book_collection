<div id="<%= dom_id book %>">
  <p>
    <strong>Title:</strong>
    <%= book.title %>
  </p>
  <p>
    <strong>Author:</strong>
    <%= book.author %>
    &emsp;
    <strong>Price:</strong>
    <%= book.price %>
    &emsp;
    <strong>Published:</strong>
    <%= book.published_date %>
  </p>

</div>
