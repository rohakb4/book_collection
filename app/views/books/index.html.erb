<p style="color: green"><%= notice %></p>

<% content_for :title, "Books" %>

<h1>Books</h1>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>
    <div>
      <%= link_to "Show Book", book %>
      &ensp;|&ensp;
      <%= link_to "Edit Book", edit_book_path(book) %>
      &ensp;|&ensp;
      <%= button_to "Delete Book", book, 
          method: :delete, 
          form: {
            data: {turbo_confirm: "Are you sure you want to delete '#{book.title}?'"}, 
            style: "display: inline-block;"
          }
      %>
    </div>
  <% end %>
</div>

<p><%= link_to "New Book", new_book_path %></p>
